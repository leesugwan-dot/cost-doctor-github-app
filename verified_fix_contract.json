{
  "schema": "costdoctor.verified-fix-contract.v2",
  "status": "PUBLIC_CANDIDATE_DEFERRED_UNTIL_USER_REACTION",
  "enabled_for_general_users": false,
  "default_mode": "READ_ONLY_PLAN_AND_TEST_IF_SEPARATELY_AUTHORIZED",
  "stages": [
    {
      "id": "diagnose",
      "repository_write": false,
      "user_approval_required": false
    },
    {
      "id": "prepare_fix_in_isolated_workspace",
      "repository_write": false,
      "user_approval_required": false
    },
    {
      "id": "before_after_and_quality_validation",
      "repository_write": false,
      "user_approval_required": false,
      "external_cost_or_credentials_may_require_user_action": true
    },
    {
      "id": "publish_branch_or_pull_request",
      "repository_write": true,
      "user_approval_required": true,
      "currently_enabled": false
    },
    {
      "id": "merge",
      "repository_write": true,
      "automatic": false,
      "user_approval_required": true,
      "currently_enabled": false
    }
  ],
  "hard_rules": {
    "direct_default_branch_overwrite": false,
    "automatic_merge": false,
    "claim_savings_without_before_after_evidence": false,
    "quality_regression_accepted_as_success": false,
    "rollback_required_for_applied_fix": true,
    "secret_in_public_issue_or_report": false
  },
  "reconsider_when": "external public scan/private self-scan reaction provides enough usability and value evidence"
}
